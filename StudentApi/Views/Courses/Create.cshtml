@model StudentApi.Models.Course
@{
    ViewData["Title"] = "Ajouter un cours";
}

<div class="page-header">
    <h1 class="page-title">Ajouter un cours</h1>
    <a class="btn btn-secondary" asp-action="Index">← Retour</a>
</div>

<div class="card" style="max-width:600px;">
    <form asp-action="Create" method="post">
        <div class="form-group">
            <label asp-for="Name">Nom du cours</label>
            <input asp-for="Name" type="text" placeholder="Ex: Mathématiques" />
            <span asp-validation-for="Name" class="field-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Description">Description</label>
            <input asp-for="Description" type="text" />
        </div>
        <div class="form-row">
            <div class="form-group">
                <label asp-for="Credits">Crédits</label>
                <input asp-for="Credits" type="number" min="1" />
            </div>
            <div class="form-group">
                <label asp-for="Teacher">Professeur</label>
                <input asp-for="Teacher" type="text" />
            </div>
        </div>
        <div style="display:flex; gap:.75rem; margin-top:.5rem;">
            <button type="submit" class="btn btn-primary">Enregistrer</button>
            <a class="btn btn-secondary" asp-action="Index">Annuler</a>
        </div>
    </form>
</div>
