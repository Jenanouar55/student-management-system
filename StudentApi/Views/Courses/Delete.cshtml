@model StudentApi.Models.Course
@{
    ViewData["Title"] = "Supprimer cours";
}

<div class="page-header">
    <h1 class="page-title">Supprimer cours</h1>
    <a class="btn btn-secondary" asp-action="Index">← Retour</a>
</div>

<div class="card" style="max-width:600px;">
    <div class="confirm-box">
        <p>Êtes-vous sûr de vouloir supprimer ce cours ?</p>
    </div>
    <table class="detail-table">
        <tr>
            <th>Nom</th>
            <td>@Model.Name</td>
        </tr>
        <tr>
            <th>Professeur</th>
            <td>@Model.Teacher</td>
        </tr>
    </table>
    <form asp-action="Delete" method="post" style="margin-top:1.5rem; display:flex; gap:.75rem;">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Confirmer la suppression</button>
        <a class="btn btn-secondary" asp-action="Index">Annuler</a>
    </form>
</div>
