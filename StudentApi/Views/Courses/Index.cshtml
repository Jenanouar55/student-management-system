@model IEnumerable<StudentApi.Models.Course>
@{
    ViewData["Title"] = "Cours";
}

<div class="page-header">
    <h1 class="page-title">Cours</h1>
    <a class="btn btn-primary" asp-action="Create">+ Ajouter</a>
</div>

<div class="card">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Description</th>
                    <th>Crédits</th>
                    <th>Professeur</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.Name</td>
                        <td>@c.Description</td>
                        <td>@c.Credits</td>
                        <td>@c.Teacher</td>
                        <td>
                            <div class="actions">
                                <a class="btn btn-secondary btn-sm" asp-action="Details" asp-route-id="@c.Id">Détails</a>
                                <a class="btn btn-secondary btn-sm" asp-action="Edit"    asp-route-id="@c.Id">Modifier</a>
                                <a class="btn btn-danger btn-sm"    asp-action="Delete"  asp-route-id="@c.Id">Supprimer</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
