@model StudentApi.Models.Course
@{
    ViewData["Title"] = "Détails cours";
}

<div class="page-header">
    <h1 class="page-title">Détails cours</h1>
    <a class="btn btn-secondary" asp-action="Index">← Retour</a>
</div>

<div class="card" style="max-width:600px;">
    <table class="detail-table">
        <tr>
            <th>Nom</th>
            <td>@Model.Name</td>
        </tr>
        <tr>
            <th>Description</th>
            <td>@Model.Description</td>
        </tr>
        <tr>
            <th>Crédits</th>
            <td>@Model.Credits</td>
        </tr>
        <tr>
            <th>Professeur</th>
            <td>@Model.Teacher</td>
        </tr>
    </table>
    <div style="margin-top:1.5rem; display:flex; gap:.75rem;">
        <a class="btn btn-secondary" asp-action="Edit"   asp-route-id="@Model.Id">Modifier</a>
        <a class="btn btn-danger"    asp-action="Delete" asp-route-id="@Model.Id">Supprimer</a>
    </div>
</div>
