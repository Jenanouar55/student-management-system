@model StudentApi.Models.Student
@{
    ViewData["Title"] = "Supprimer étudiant";
}

<div class="page-header">
    <h1 class="page-title">Supprimer étudiant</h1>
    <a class="btn btn-secondary" asp-action="Index">← Retour</a>
</div>

<div class="card" style="max-width:600px;">
    <div class="confirm-box">
        <p>Êtes-vous sûr de vouloir supprimer cet étudiant ?</p>
    </div>
    <table class="detail-table">
        <tr>
            <th>Nom complet</th>
            <td>@Model.FullName</td>
        </tr>
        <tr>
            <th>Email</th>
            <td>@Model.Email</td>
        </tr>
    </table>
    <form asp-action="Delete" method="post" style="margin-top:1.5rem; display:flex; gap:.75rem;">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Confirmer la suppression</button>
        <a class="btn btn-secondary" asp-action="Index">Annuler</a>
    </form>
</div>
