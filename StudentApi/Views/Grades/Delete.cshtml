@model StudentApi.Models.Grade
@{
    ViewData["Title"] = "Supprimer la note";
}

<div class="page-header">
    <h1 class="page-title">Supprimer la note</h1>
    <a class="btn btn-secondary" asp-action="Index">← Retour</a>
</div>

<div class="card" style="max-width:600px;">
    <div class="confirm-box">
        <p>⚠️ Êtes-vous sûr de vouloir supprimer cette note ? Cette action est irréversible.</p>
    </div>
    <table class="detail-table">
        <tr>
            <th>Étudiant</th>
            <td>@Model.Student?.FullName</td>
        </tr>
        <tr>
            <th>Cours</th>
            <td>@Model.Course?.Name</td>
        </tr>
        <tr>
            <th>Note (/ 20)</th>
            <td>@Model.Score</td>
        </tr>
        <tr>
            <th>Date</th>
            <td>@Model.Date.ToString("dd/MM/yyyy")</td>
        </tr>
    </table>
    <form asp-action="Delete" method="post" style="margin-top:1.5rem; display:flex; gap:.75rem;">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Confirmer la suppression</button>
        <a class="btn btn-secondary" asp-action="Index">Annuler</a>
    </form>
</div>
