@model StudentApi.Models.Grade
@{
    ViewData["Title"] = "Modifier note";
}

<div class="page-header">
    <h1 class="page-title">Modifier note</h1>
    <a class="btn btn-secondary" asp-action="Index">← Retour</a>
</div>

<div class="card" style="max-width:600px;">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <label asp-for="StudentId">Étudiant</label>
            <select asp-for="StudentId" asp-items="ViewBag.Students"></select>
        </div>
        <div class="form-group">
            <label asp-for="CourseId">Cours</label>
            <select asp-for="CourseId" asp-items="ViewBag.Courses"></select>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label asp-for="Score">Note (/ 20)</label>
                <input asp-for="Score" type="number" step="0.5" min="0" max="20" />
            </div>
            <div class="form-group">
                <label asp-for="Note">Remarque</label>
                <input asp-for="Note" type="text" />
            </div>
        </div>
        <div class="form-group">
            <label asp-for="Date">Date</label>
            <input asp-for="Date" type="datetime-local" />
        </div>
        <div style="display:flex; gap:.75rem; margin-top:.5rem;">
            <button type="submit" class="btn btn-primary">Enregistrer</button>
            <a class="btn btn-secondary" asp-action="Index">Annuler</a>
        </div>
    </form>
</div>
