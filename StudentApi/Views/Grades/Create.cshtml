@model StudentApi.Models.Grade
@{
    ViewData["Title"] = "Ajouter une note";
}

<div class="page-header">
    <h1 class="page-title">Ajouter une note</h1>
    <a class="btn btn-secondary" asp-action="Index">← Retour</a>
</div>

<div class="card" style="max-width:600px;">
    <form asp-action="Create" method="post">
        <div class="form-group">
            <label asp-for="StudentId">Étudiant</label>
            <select asp-for="StudentId" asp-items="ViewBag.Students">
                <option value="">-- Choisir un étudiant --</option>
            </select>
        </div>
        <div class="form-group">
            <label asp-for="CourseId">Cours</label>
            <select asp-for="CourseId" asp-items="ViewBag.Courses">
                <option value="">-- Choisir un cours --</option>
            </select>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label asp-for="Score">Note (/ 20)</label>
                <input asp-for="Score" type="number" step="0.5" min="0" max="20" />
            </div>
            <div class="form-group">
                <label asp-for="Note">Remarque</label>
                <input asp-for="Note" type="text" />
            </div>
        </div>
        <div style="display:flex; gap:.75rem; margin-top:.5rem;">
            <button type="submit" class="btn btn-primary">Enregistrer</button>
            <a class="btn btn-secondary" asp-action="Index">Annuler</a>
        </div>
    </form>
</div>
