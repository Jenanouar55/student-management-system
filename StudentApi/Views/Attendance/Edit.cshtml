@model StudentApi.Models.Attendance
@{
    ViewData["Title"] = "Modifier la présence";
}

<div class="page-header">
    <h1 class="page-title">Modifier la présence</h1>
    <a class="btn btn-secondary" asp-action="Index">← Retour</a>
</div>

<div class="card" style="max-width:600px;">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <label asp-for="StudentId">Étudiant</label>
            <select asp-for="StudentId" asp-items="ViewBag.Students"></select>
            <span asp-validation-for="StudentId" class="field-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Date">Date</label>
            <input asp-for="Date" type="datetime-local" />
            <span asp-validation-for="Date" class="field-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Status">Statut</label>
            <select asp-for="Status">
                <option value="Présent">Présent</option>
                <option value="Absent">Absent</option>
                <option value="En retard">En retard</option>
            </select>
            <span asp-validation-for="Status" class="field-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Remark">Remarque</label>
            <input asp-for="Remark" type="text" />
        </div>
        <div style="display:flex; gap:.75rem; margin-top:.5rem;">
            <button type="submit" class="btn btn-primary">Enregistrer</button>
            <a class="btn btn-secondary" asp-action="Index">Annuler</a>
        </div>
    </form>
</div>
