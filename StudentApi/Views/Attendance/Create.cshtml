@model StudentApi.Models.Attendance
@{
    ViewData["Title"] = "Ajouter une présence";
}

<div class="page-header">
    <h1 class="page-title">Ajouter une présence</h1>
    <a class="btn btn-secondary" asp-action="Index">← Retour</a>
</div>

<div class="card" style="max-width:600px;">
    <form asp-action="Create" method="post">
        <div class="form-group">
            <label asp-for="StudentId">Étudiant</label>
            <select asp-for="StudentId" asp-items="ViewBag.Students">
                <option value="">-- Choisir un étudiant --</option>
            </select>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label asp-for="Date">Date</label>
                <input asp-for="Date" type="datetime-local" />
            </div>
            <div class="form-group">
                <label asp-for="Status">Statut</label>
                <select asp-for="Status">
                    <option value="Present">Présent</option>
                    <option value="Absent">Absent</option>
                    <option value="Late">En retard</option>
                </select>
            </div>
        </div>
        <div class="form-group">
            <label asp-for="Remark">Remarque</label>
            <input asp-for="Remark" type="text" />
        </div>
        <div style="display:flex; gap:.75rem; margin-top:.5rem;">
            <button type="submit" class="btn btn-primary">Enregistrer</button>
            <a class="btn btn-secondary" asp-action="Index">Annuler</a>
        </div>
    </form>
</div>
